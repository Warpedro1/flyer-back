# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
# Secret key (sb_secret_...) de Settings > API Keys. A service_role legacy (eyJ...)
# ainda funciona, mas o Supabase desativa-a no fim de 2026.
SUPABASE_KEY=sb_secret_your_key
# Legacy JWT secret de Settings > JWT Keys (só serve de fallback HS256). Não é uma API key.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

OPENAI_KEY=

# Pusher
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=eu

# Flyer AI defaults
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHAT_MODEL=gpt-4o
CHAT_MAX_TOKENS=500
USER_INPUT_MAX_LENGTH=1000

# LangChain-style model names (optional; default to EMBEDDING_MODEL / CHAT_MODEL when empty)
EMBEDDINGS_MODEL=
LLM_MODEL=

# LangSmith (optional tracing)
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Check-in por QR (lotação / lista de espera). Segredo próprio, separado do
# SUPABASE_JWT_SECRET: um QR é uma chave de porta, não uma sessão. Vazio = QR
# desligado (503). Gerar com: python -c "import secrets; print(secrets.token_hex(32))"
RSVP_QR_SECRET=
# Validade do token dentro do QR. Curta de propósito: uma foto do ecrã de outra
# pessoa deixa de servir antes de chegar à porta.
RSVP_QR_TTL_SECONDS=45

# Domain
CHECKIN_MAX_DISTANCE_METERS=200
INTEREST_WEIGHT_CURRENT=0.7
INTEREST_WEIGHT_NEW=0.3

# Catálogo (Apify -> transformação determinística -> upsert). Opcional: sem estas
# variáveis os endpoints /admin/ingest respondem 503. Fontes e tetos de custo:
# app/services/etl/sources.py.
APIFY_TOKEN=
# Segredo do header X-Admin-Token em POST /admin/ingest (inicia um run no Apify).
ADMIN_INGEST_TOKEN=
# Segredo que o Apify devolve no webhook quando o run acaba. Diferente do token de
# admin: fica guardado no Apify, por isso só abre o webhook.
APIFY_WEBHOOK_SECRET=
# URL pública desta API, para o webhook. Vazio = o host do pedido.
PUBLIC_API_BASE_URL=

# Rate limiting (#8). Store partilhado dos contadores (Redis/Upstash). Vazio = memória
# de cada instância, o que na Vercel não limita nada de verdade. O Upstash ligado pelo
# Marketplace da Vercel já cria REDIS_URL / KV_URL, que também são lidos.
RATE_LIMIT_STORAGE_URI=
