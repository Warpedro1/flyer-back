# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

OPENAI_KEY=

# Pusher
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=eu

# Flyer AI defaults
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHAT_MODEL=gpt-4o
CHAT_MAX_TOKENS=500
USER_INPUT_MAX_LENGTH=1000

# LangChain-style model names (optional; default to EMBEDDING_MODEL / CHAT_MODEL when empty)
EMBEDDINGS_MODEL=
LLM_MODEL=

# LangSmith (optional tracing)
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Domain
CHECKIN_MAX_DISTANCE_METERS=200
INTEREST_WEIGHT_CURRENT=0.7
INTEREST_WEIGHT_NEW=0.3

# ETL de eventos reais (Apify -> LLM -> upsert). Opcional: sem APIFY_TOKEN usa dados mock.
APIFY_TOKEN=
APIFY_EVENTS_ACTOR=johnvc~google-events-api---access-google-events-data
APIFY_EVENTS_LANG=pt
APIFY_EVENTS_COUNTRY=
# Opcional: localizacao canonica do Google (ex.: Lisbon,Lisbon,Portugal). Vazio = so a query.
APIFY_EVENTS_LOCATION=
ETL_TRANSFORM_MODEL=gpt-4o-mini
# Segredo do header X-Admin-Token em POST /admin/ingest. Vazio = endpoint desligado (503).
ADMIN_INGEST_TOKEN=
